# Names only. Never put real credentials in this file or in git.
# Values below are empty on purpose.

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=

# --- API (NestJS) ---
NODE_ENV=
API_PORT=
LOG_LEVEL=
SESSION_SECRET=
SESSION_TTL_SECONDS=
COOKIE_SECURE=
# Shared only between the Next.js server and the API. Not a user credential.
INTERNAL_BFF_TOKEN=

# --- PostgreSQL ---
DATABASE_URL=

# --- Redis / BullMQ ---
REDIS_URL=

# --- Object storage (S3-compatible). Three buckets, all private except public previews. ---
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_QUARANTINE=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=

# Short-lived download URL lifetime. Policy not approved. Placeholder name only.
DOWNLOAD_URL_TTL_SECONDS=

# --- Malware / archive scanner (isolated worker). No engine chosen. ---
SCANNER_MODE=
SCANNER_ENDPOINT=

# --- Payments. Provider is OPEN. Use a fake driver until a provider is approved. ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CONNECT_CLIENT_ID=

# Commission is configurable. No approved rate. Store basis points when a policy exists.
# PLATFORM_COMMISSION_BPS=

# --- Notifications (transport not chosen) ---
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
