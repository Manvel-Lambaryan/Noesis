generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "commerce", "ops"]
}

/// Non-business anchors so Slice 1 can create the four accepted schemas.
model IdentityAnchor {
  id String @id @default("identity")

  @@map("schema_anchor")
  @@schema("identity")
}

enum UserState {
  active

  @@schema("identity")
}

enum RoleName {
  buyer
  seller
  admin

  @@schema("identity")
}

enum AdminPermissionName {
  moderation
  finance

  @@schema("identity")
}

enum AuthTokenPurpose {
  email_verification
  password_reset

  @@schema("identity")
}

enum SellerVerificationState {
  draft
  verification_submitted
  verification_approved
  verification_rejected
  suspended

  @@schema("identity")
}

/// iam owns users, sessions, roles, admin permissions, and auth tokens.
model User {
  id              String    @id @db.Uuid
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  state           UserState @default(active)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  roles           RoleAssignment[]
  permissions     AdminPermission[]
  tokens          AuthToken[]

  @@map("users")
  @@schema("identity")
}

model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model RoleAssignment {
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String   @map("user_id") @db.Uuid
  role   RoleName

  @@id([userId, role])
  @@map("role_assignments")
  @@schema("identity")
}

model AdminPermission {
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String              @map("user_id") @db.Uuid
  permission AdminPermissionName

  @@id([userId, permission])
  @@map("admin_permissions")
  @@schema("identity")
}

model AuthToken {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
  @@schema("identity")
}

/// seller owns profiles. user_id has no foreign key: iam and seller are different modules.
model SellerProfile {
  id                 String                  @id @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  displayName        String                  @map("display_name") @db.VarChar(80)
  verificationState  SellerVerificationState @default(draft) @map("verification_state")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("seller_profiles")
  @@schema("identity")
}

model CatalogAnchor {
  id String @id @default("catalog")

  @@map("schema_anchor")
  @@schema("catalog")
}

enum ProductKind {
  code_asset
  business_application

  @@schema("catalog")
}

enum ListingState {
  draft
  published
  unpublished
  taken_down
  appeal_pending

  @@schema("catalog")
}

/// catalog owns categories. Identifiers are stable. Later admin edits do not need a migration.
model Category {
  id        String     @id @db.Uuid
  slug      String     @unique @db.VarChar(80)
  name      String     @db.VarChar(80)
  sortOrder Int        @map("sort_order")
  active    Boolean    @default(true)
  parentId  String?    @map("parent_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([active, sortOrder])
  @@map("categories")
  @@schema("catalog")
}

/// seller_id has no foreign key. iam and catalog are different modules.
model Product {
  id           String         @id @db.Uuid
  sellerId     String         @map("seller_id") @db.Uuid
  slug         String         @unique @db.VarChar(120)
  title        String         @db.VarChar(120)
  summary      String         @default("") @db.VarChar(4000)
  kind         ProductKind
  categoryId   String         @map("category_id") @db.Uuid
  listingState ListingState   @default(draft) @map("listing_state")
  curated      Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stacks       ProductStack[]
  tags         ProductTag[]
  previews     PreviewImage[]
  intents      PreviewIntent[]

  @@index([sellerId, updatedAt])
  @@map("products")
  @@schema("catalog")
}

model ProductStack {
  productId String  @map("product_id") @db.Uuid
  stackCode String  @map("stack_code") @db.VarChar(32)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, stackCode])
  @@map("product_stacks")
  @@schema("catalog")
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tag       String  @db.VarChar(32)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, tag])
  @@map("product_tags")
  @@schema("catalog")
}

model PreviewImage {
  id          String   @id @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  objectKey   String   @unique @map("object_key") @db.VarChar(200)
  contentType String   @map("content_type") @db.VarChar(32)
  byteSize    Int      @map("byte_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("preview_images")
  @@schema("catalog")
}

model PreviewIntent {
  id          String    @id @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  contentType String    @map("content_type") @db.VarChar(32)
  byteSize    Int       @map("byte_size")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("preview_intents")
  @@schema("catalog")
}

/// discovery owns this configuration. javascript.mode "stack" is a technical default, not an owner decision.
model DiscoveryView {
  viewId  String  @id @map("view_id") @db.VarChar(40)
  label   String  @db.VarChar(80)
  enabled Boolean @default(true)
  mode    String  @db.VarChar(40)

  @@map("discovery_views")
  @@schema("catalog")
}

/// One row per product. No foreign key to catalog.products. search_vector is added in SQL.
model DiscoveryDocument {
  productId    String   @id @map("product_id") @db.Uuid
  slug         String   @unique @db.VarChar(120)
  title        String   @db.VarChar(120)
  summary      String   @db.VarChar(4000)
  kind         String   @db.VarChar(40)
  categoryId   String   @map("category_id") @db.Uuid
  categorySlug String   @map("category_slug") @db.VarChar(80)
  categoryName String   @map("category_name") @db.VarChar(80)
  stacks       String[]
  tags         String[]
  previewUrls  String[] @map("preview_urls")
  listingState String   @map("listing_state") @db.VarChar(40)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([listingState, updatedAt])
  @@map("discovery_documents")
  @@schema("catalog")
}

enum VersionState {
  draft
  upload_pending
  quarantined
  scanning
  scan_rejected
  pending_moderation
  approved
  rejected
  withdrawn

  @@schema("catalog")
}

/// artifacts owns versions. product_id has no foreign key: catalog and artifacts are different modules.
model ProductVersion {
  id            String        @id @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  versionLabel  String        @map("version_label") @db.VarChar(40)
  state         VersionState  @default(draft)
  byteSize      BigInt?       @map("byte_size")
  sha256        String?       @db.VarChar(64)
  quarantineKey String?       @map("quarantine_key") @db.VarChar(240)
  privateKey    String?       @map("private_key") @db.VarChar(240)
  reasonCode    String?       @map("reason_code") @db.VarChar(80)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  intents       UploadIntent[]

  @@unique([productId, versionLabel])
  @@index([sellerId, state])
  @@map("product_versions")
  @@schema("catalog")
}

model UploadIntent {
  id          String         @id @db.Uuid
  versionId   String         @map("version_id") @db.Uuid
  tokenHash   String         @unique @map("token_hash")
  contentType String         @map("content_type") @db.VarChar(40)
  byteSize    BigInt         @map("byte_size")
  objectKey   String         @map("object_key") @db.VarChar(240)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?      @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  version     ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("upload_intents")
  @@schema("catalog")
}

model ScanReport {
  id         String   @id @db.Uuid
  versionId  String   @unique @map("version_id") @db.Uuid
  verdict    String   @db.VarChar(16)
  reasonCode String   @map("reason_code") @db.VarChar(80)
  engine     String   @db.VarChar(40)
  scannedAt  DateTime @map("scanned_at") @db.Timestamptz(3)

  @@map("scan_reports")
  @@schema("catalog")
}

model ArtifactOutbox {
  id          String    @id @db.Uuid
  type        String    @db.VarChar(80)
  subjectId   String    @map("subject_id") @db.Uuid
  payload     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([subjectId, type])
  @@map("artifact_outbox")
  @@schema("catalog")
}

model CatalogOutbox {
  id          String    @id @db.Uuid
  type        String    @db.VarChar(80)
  subjectId   String    @map("subject_id") @db.Uuid
  payload     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([subjectId, type])
  @@map("catalog_outbox")
  @@schema("catalog")
}

model CommerceAnchor {
  id String @id @default("commerce")

  @@map("schema_anchor")
  @@schema("commerce")
}

model OpsAnchor {
  id String @id @default("ops")

  @@map("schema_anchor")
  @@schema("ops")
}

model ModerationDecision {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(40)
  subjectType String   @map("subject_type") @db.VarChar(40)
  subjectId   String   @map("subject_id") @db.Uuid
  note        String   @default("") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@map("moderation_decisions")
  @@schema("ops")
}

model Appeal {
  id         String    @id @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  sellerId   String    @map("seller_id") @db.Uuid
  note       String    @db.VarChar(500)
  state      String    @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(3)

  @@index([productId, state])
  @@map("appeals")
  @@schema("ops")
}

model AuditEvent {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(40)
  subjectType String   @map("subject_type") @db.VarChar(40)
  subjectId   String   @map("subject_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@map("audit_events")
  @@schema("ops")
}
